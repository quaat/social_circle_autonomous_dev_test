# Copy to .env and adjust. Never commit .env.
# All values below are development defaults for synthetic test accounts only.

# --- PostgreSQL (compose service "db") ---------------------------------------
POSTGRES_USER=socialcircle
POSTGRES_PASSWORD=socialcircle-dev-password
POSTGRES_DB=socialcircle
# Host port the compose db service is published on. 5440 avoids the common
# 5432/5433 collisions with other local Postgres instances.
POSTGRES_PORT=5440

# --- Backend (FastAPI) --------------------------------------------------------
# Used by the backend when run on the host (uv run ...). Inside compose the
# backend service overrides the host with "db".
DATABASE_URL=postgresql+psycopg://socialcircle:socialcircle-dev-password@localhost:5440/socialcircle
# Separate database for backend integration tests (created by `make setup`).
TEST_DATABASE_URL=postgresql+psycopg://socialcircle:socialcircle-dev-password@localhost:5440/socialcircle_test
BACKEND_PORT=8010
# Session cookie settings. SESSION_COOKIE_SECURE must be true behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
APP_ENV=development

# --- Frontend (Angular dev server) ------------------------------------------
FRONTEND_PORT=4200
# The Angular dev server proxies /api to this origin (same-origin cookies).
API_PROXY_TARGET=http://localhost:8010
